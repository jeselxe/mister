<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto w-full max-w-7xl space-y-8 tabular-nums">
    <%!-- Cabecera --%>
    <div class="flex flex-wrap items-center justify-between gap-4" id="report-header">
      <div>
        <h1 class="text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          Informe diario <span class="text-emerald-600">Mister</span>
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          {if(@report, do: Date.to_string(@report.report_date), else: "sin informe")} · el sistema recomienda, tú ejecutas
        </p>
      </div>
      <button
        id="run-analysis"
        type="button"
        phx-click="run_analysis"
        class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white shadow-md shadow-emerald-600/30 transition hover:-translate-y-0.5 hover:bg-emerald-500 hover:shadow-lg active:translate-y-0 phx-click-loading:pointer-events-none phx-click-loading:opacity-60"
      >
        <.icon name="hero-arrow-path" class="h-4 w-4" /> Ejecutar análisis ahora
      </button>
    </div>

    <%= if @report == nil do %>
      <%!-- Estado vacío --%>
      <div
        id="empty-report"
        class="rounded-2xl border border-dashed border-slate-300 p-12 text-center"
      >
        <.icon name="hero-moon" class="mx-auto h-10 w-10 text-slate-300" />
        <p class="mt-3 font-semibold text-slate-700">Todavía no hay informe</p>
        <p class="mt-1 text-sm text-slate-500">
          El análisis corre cada día a las 7:00 (hora española) o puedes lanzarlo ahora mismo.
        </p>
      </div>
    <% else %>
      <%!-- Alertas (prioridad máxima: presupuesto en rojo) --%>
      <div id="alerts" class="space-y-2">
        <div
          :for={alert <- @report.alerts || []}
          class={[
            "flex items-start gap-3 rounded-xl border px-4 py-3 text-sm font-medium",
            if(red_alert?(alert),
              do: "border-red-300 bg-red-50 text-red-800",
              else: "border-amber-300 bg-amber-50 text-amber-900"
            )
          ]}
        >
          <.icon
            name={
              if red_alert?(alert),
                do: "hero-exclamation-triangle",
                else: "hero-information-circle"
            }
            class="mt-0.5 h-5 w-5 shrink-0"
          />
          {plain_text(alert)}
        </div>
      </div>

      <%!-- Presupuesto --%>
      <% budget = @report.budget_summary || %{} %>
      <section id="budget-summary" class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <div class="border-t border-slate-200 pt-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Saldo real</p>
          <p class={balance_classes(budget["real_now"])}>
            {money(budget["real_now"])}
          </p>
          <p class="mt-0.5 text-xs text-slate-500">disponible ahora mismo</p>
        </div>
        <div class="border-t border-slate-200 pt-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Proyectado tras ventas
          </p>
          <p class="mt-1 text-xl font-black text-slate-900">{money(budget["real_projected"])}</p>
          <p class="mt-0.5 text-xs text-slate-500">si se venden los jugadores en venta</p>
        </div>
        <div class="border-t border-slate-200 pt-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Puja máx. actual
          </p>
          <p class="mt-1 text-xl font-black text-slate-900">{money(budget["bid_allowed_now"])}</p>
          <p class="mt-0.5 text-xs text-slate-500">{bid_rule_label(budget["bid_rule"] || "")}</p>
        </div>
        <div class="border-t border-slate-200 pt-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Puja máx. proyectada
          </p>
          <p class="mt-1 text-xl font-black text-slate-900">
            {money(budget["bid_allowed_projected"])}
          </p>
          <p class="mt-0.5 text-xs text-slate-500">tras cerrar las ventas</p>
        </div>
      </section>

      <%!-- Leyenda: los números del informe, en lenguaje llano --%>
      <details
        id="report-legend"
        class="group border-t border-slate-200 pt-4 text-xs text-slate-600"
      >
        <summary class="inline-flex cursor-pointer list-none items-center gap-1 font-semibold text-slate-700 [&::-webkit-details-marker]:hidden">
          ¿Qué significan los números?
          <.icon
            name="hero-chevron-down"
            class="h-3.5 w-3.5 transition-transform group-open:rotate-180"
          />
        </summary>
        <dl class="mt-2 grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
          <div>
            <dt class="inline font-semibold text-slate-700">Clausulazo</dt>
            <dd class="inline">
              pagas la cláusula de un rival y te lo llevas al instante; el % es lo que la cláusula supera su valor de mercado.
            </dd>
          </div>
          <div>
            <dt class="inline font-semibold text-slate-700">ratio pts/M€</dt>
            <dd class="inline">
              puntos de media por millón de cláusula: cuanto más alto, más rinde cada euro.
            </dd>
          </div>
          <div>
            <dt class="inline font-semibold text-slate-700">banca / usuario</dt>
            <dd class="inline">
              si el jugador lo pone en venta la banca (sin dueño) o otro mánager.
            </dd>
          </div>
          <div>
            <dt class="inline font-semibold text-slate-700">reventa 95–105%</dt>
            <dd class="inline">
              al ponerlo en venta, la banca ofrece entre el 95% y el 105% del valor ese día.
            </dd>
          </div>
          <div>
            <dt class="inline font-semibold text-slate-700">ganancia</dt>
            <dd class="inline">
              reventa esperada menos lo que pagas (la puja, o el precio de mercado si solo sigues).
            </dd>
          </div>
          <div>
            <dt class="inline font-semibold text-slate-700">pujar hasta</dt>
            <dd class="inline">
              máximo sugerido: precio + 5%, sin pasar de la reventa esperada ni de tu tope de liga.
            </dd>
          </div>
        </dl>
      </details>

      <%!-- Accesos directos a cada sección --%>
      <nav id="report-nav" class="flex flex-wrap gap-2 text-xs font-semibold">
        <a
          href="#clauses"
          class="rounded-full bg-white px-3 py-1 text-slate-600 ring-1 ring-slate-200 transition hover:text-slate-900 hover:ring-slate-300"
        >
          Clausulazos
          <span class="text-slate-500">{length(List.wrap(@report.clause_targets))}</span>
        </a>
        <a
          href="#buy-recommendations"
          class="rounded-full bg-white px-3 py-1 text-slate-600 ring-1 ring-slate-200 transition hover:text-slate-900 hover:ring-slate-300"
        >
          Fichajes
          <span class="text-slate-500">
            {length(filter_buys(List.wrap(@report.buy_recommendations), @only_bank))}
          </span>
        </a>
        <a
          href="#best-lineup"
          class="rounded-full bg-white px-3 py-1 text-slate-600 ring-1 ring-slate-200 transition hover:text-slate-900 hover:ring-slate-300"
        >
          Alineación
        </a>
        <a
          href="#sell-recommendations"
          class="rounded-full bg-white px-3 py-1 text-slate-600 ring-1 ring-slate-200 transition hover:text-slate-900 hover:ring-slate-300"
        >
          En venta
          <span class="text-slate-500">{length(List.wrap(@report.sell_recommendations))}</span>
        </a>
        <a
          href="#sell-hints"
          class="rounded-full bg-white px-3 py-1 text-slate-600 ring-1 ring-slate-200 transition hover:text-slate-900 hover:ring-slate-300"
        >
          Poner en venta
          <span class="text-slate-500">{length(List.wrap(@report.sell_hints))}</span>
        </a>
      </nav>

      <div class="grid gap-x-10 gap-y-10 lg:grid-cols-5">
        <div class="space-y-8 lg:col-span-3">
          <%!-- Clausulazos --%>
          <section id="clauses" class="border-t border-slate-200 pt-5">
            <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-700">
              <.icon name="hero-bolt" class="h-5 w-5 text-amber-500" /> Clausulazos pagables
            </h2>
            <ul class="mt-3 divide-y divide-slate-200">
              <li
                :for={target <- List.wrap(@report.clause_targets)}
                id={"clause-#{target["player_id"]}"}
                class={[
                  "flex items-center justify-between gap-3 py-3 first:pt-0 last:pb-0",
                  done_or_dismissed?(@action_map[{"clause", target["player_id"]}]) && "opacity-60"
                ]}
              >
                <div class="flex min-w-0 items-center gap-3">
                  <.player_side rec={target} />
                  <img
                    src={player_photo_url(target["player_id"])}
                    alt={target["name"]}
                    class="h-10 w-10 shrink-0 rounded-full bg-slate-100 object-cover ring-1 ring-slate-200"
                  />
                  <div>
                    <p class="flex flex-wrap items-center gap-1.5 font-bold text-slate-900">
                      {target["name"]}
                    </p>
                    <p class="text-xs text-slate-500">
                      {if(target["owner_name"],
                        do: "de " <> target["owner_name"] <> " · ",
                        else: ""
                      )}media {pts(target["season_avg"])} · ratio {pts(
                        target["value_per_million"]
                      )} pts/M€
                    </p>
                    <p :if={target["player_value"]} class="text-[11px] text-slate-500">
                      valor {money(target["player_value"])}
                      <span
                        :if={target["clause_premium_pct"]}
                        class={premium_classes(target["clause_premium_pct"])}
                      >
                        · +{target["clause_premium_pct"]}% sobre valor
                      </span>
                    </p>
                  </div>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-sm font-black text-amber-800 ring-1 ring-amber-300">
                    <.icon name="hero-bolt" class="h-4 w-4" /> {money(target["clause_price"])}
                  </span>
                  <.action_controls action={@action_map[{"clause", target["player_id"]}]} />
                </div>
              </li>
            </ul>
            <p
              :if={@report.clause_targets in [nil, []]}
              class="mt-3 text-sm text-slate-500"
              id="clauses-none"
            >
              No hay clausulazos pagables con tu saldo actual.
            </p>
          </section>

          <%!-- Fichajes: pujas con importe + seguimientos sin puja --%>
          <% buys = List.wrap(@report.buy_recommendations) |> filter_buys(@only_bank) %>
          <% bid_buys = Enum.filter(buys, &bid?/1) %>
          <% watched_buys = Enum.reject(buys, &bid?/1) %>
          <section
            id="buy-recommendations"
            class="border-t border-slate-200 pt-5"
          >
            <div class="flex items-center justify-between gap-2">
              <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-700">
                <.icon name="hero-shopping-bag" class="h-5 w-5 text-sky-600" />
                Fichajes &amp; pujas
              </h2>
              <div class="flex shrink-0 rounded-lg bg-slate-100 p-0.5 text-[11px] font-bold">
                <button
                  type="button"
                  phx-click="market_filter"
                  phx-value-scope="bank"
                  id="market-filter-bank"
                  class={[
                    "rounded-md px-2.5 py-1 transition",
                    if(@only_bank,
                      do: "bg-white text-slate-900 shadow-sm",
                      else: "text-slate-500 hover:text-slate-700"
                    )
                  ]}
                >
                  Solo banca
                </button>
                <button
                  type="button"
                  phx-click="market_filter"
                  phx-value-scope="all"
                  id="market-filter-all"
                  class={[
                    "rounded-md px-2.5 py-1 transition",
                    if(@only_bank,
                      do: "text-slate-500 hover:text-slate-700",
                      else: "bg-white text-slate-900 shadow-sm"
                    )
                  ]}
                >
                  Todos
                </button>
              </div>
            </div>
            <p class="mt-1 text-xs text-slate-500">
              Solo se propone puja si la revalorización proyectada la justifica. El resto son seguimientos, sin importe.
            </p>

            <%!-- Pujar ahora --%>
            <p class="mt-3 text-xs font-black uppercase tracking-wide text-sky-600">
              Pujar ahora
            </p>
            <ul class="mt-1 divide-y divide-slate-200">
              <li
                :for={rec <- bid_buys}
                id={"buy-#{rec["player_id"]}"}
                class={[
                  "py-2.5 first:pt-0 last:pb-0",
                  done_or_dismissed?(@action_map[{"buy", rec["player_id"]}]) && "opacity-60"
                ]}
              >
                <div class="flex items-center justify-between gap-3">
                  <.player_side rec={rec} />
                  <img
                    src={player_photo_url(rec["player_id"])}
                    alt={rec["name"]}
                    class="h-9 w-9 shrink-0 rounded-full bg-slate-100 object-cover ring-1 ring-slate-200"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="flex flex-wrap items-center gap-1.5 font-bold text-slate-900">
                      {rec["name"]}
                      <span
                        class={trend_classes(rec["trend"])}
                        title={"tendencia " <> (rec["trend"] || "flat")}
                      >
                        <.icon name={trend_icon(rec["trend"])} class="h-3.5 w-3.5" />
                        {trend_label(rec["trend"])}
                      </span>
                      <span
                        class={[
                          "rounded-full px-2 py-0.5 text-[10px] font-black uppercase tracking-wide ring-1",
                          if(rec["source"] == "banca",
                            do: "bg-emerald-50 text-emerald-700 ring-emerald-200",
                            else: "bg-slate-100 text-slate-600 ring-slate-200"
                          )
                        ]}
                        title={
                          if(rec["source"] == "banca",
                            do: "Listado por la banca (sin propietario)",
                            else: "Listado por " <> (rec["seller_name"] || "otro usuario")
                          )
                        }
                      >
                        {rec["source"] || "mercado"}
                      </span>
                    </p>
                    <p class="mt-0.5 text-xs text-slate-500">
                      <span class={growth_classes(rec["potential_gain_pct"])}>
                        ganancia {signed_money(rec["potential_gain"])} ({signed_pct(
                          rec["potential_gain_pct"]
                        )})
                      </span>
                      · {money(rec["price"])} ·
                      <span class={growth_classes(rec["growth_7d"])}>
                        7d {signed_pct(rec["growth_7d"]) || "sin datos"}
                      </span>
                    </p>
                  </div>
                  <div class="flex shrink-0 items-center gap-2">
                    <span class="rounded-lg bg-sky-50 px-2.5 py-1 text-xs font-bold text-sky-700 ring-1 ring-sky-200">
                      pujar hasta {money(rec["suggested_bid"])}
                    </span>
                    <.action_controls action={@action_map[{"buy", rec["player_id"]}]} />
                  </div>
                </div>
                <%= if rec["id_market"] && rec["suggested_bid"] do %>
                  <div class="mt-1.5 flex flex-wrap items-center justify-end gap-2">
                    <%= if @confirming_bid == rec["player_id"] do %>
                      <button
                        type="button"
                        phx-click="place_bid"
                        phx-value-id_market={rec["id_market"]}
                        phx-value-id_player={rec["player_id"]}
                        phx-value-amount={rec["suggested_bid"]}
                        phx-value-offeree_id={rec["offeree_id"] || ""}
                        id={"confirm-bid-#{rec["player_id"]}"}
                        class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white shadow-md shadow-emerald-600/30 transition hover:bg-emerald-500 active:scale-95 phx-click-loading:pointer-events-none phx-click-loading:opacity-60"
                      >
                        Confirmar puja {money(rec["suggested_bid"])}
                      </button>
                      <button
                        type="button"
                        phx-click="cancel_bid"
                        id={"cancel-bid-#{rec["player_id"]}"}
                        class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-slate-700 ring-1 ring-slate-300 transition hover:bg-slate-50 active:scale-95"
                      >
                        Cancelar
                      </button>
                    <% else %>
                      <button
                        type="button"
                        phx-click="place_bid"
                        phx-value-id_market={rec["id_market"]}
                        phx-value-id_player={rec["player_id"]}
                        phx-value-amount={rec["suggested_bid"]}
                        phx-value-offeree_id={rec["offeree_id"] || ""}
                        id={"place-bid-#{rec["player_id"]}"}
                        class="rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-bold text-white shadow-md shadow-sky-600/30 transition hover:bg-sky-500 active:scale-95 phx-click-loading:pointer-events-none phx-click-loading:opacity-60"
                      >
                        Pujar {money(rec["suggested_bid"])}
                      </button>
                    <% end %>
                  </div>
                <% end %>
                <.bid_slider :if={slider?(rec)} id={"bid-slider-#{rec["player_id"]}"} rec={rec} />
              </li>
            </ul>
            <p
              :if={bid_buys == []}
              class="mt-2 text-sm text-slate-500"
              id="buys-none"
            >
              Hoy ninguna puja clara: la proyección de reventa no compensa el riesgo.
            </p>

            <%!-- Seguir: en alza pero sin puja recomendada --%>
            <div :if={watched_buys != []} class="mt-4 border-t border-slate-200 pt-3">
              <p class="text-xs font-black uppercase tracking-wide text-slate-500">
                Seguir (sin puja)
              </p>
              <ul class="mt-1 grid gap-x-4 xl:grid-cols-2">
                <li
                  :for={rec <- watched_buys}
                  id={"watch-#{rec["player_id"]}"}
                  class="border-b border-slate-200 py-2"
                >
                  <div class="flex items-center justify-between gap-3">
                    <.player_side rec={rec} />
                    <img
                      src={player_photo_url(rec["player_id"])}
                      alt={rec["name"]}
                      class="h-8 w-8 shrink-0 rounded-full bg-slate-100 object-cover ring-1 ring-slate-200"
                    />
                    <div class="min-w-0 flex-1">
                      <p class="flex flex-wrap items-center gap-1.5 text-sm font-semibold text-slate-800">
                        {rec["name"]}
                        <span class={growth_classes(rec["growth_7d"])}>
                          {signed_pct(rec["growth_7d"]) || "sin datos"} 7d
                        </span>
                      </p>
                      <p class="text-[11px] text-slate-500">
                        {money(rec["price"])} ·
                        <span class={growth_classes(rec["potential_gain_pct"])}>
                          ganancia {signed_money(rec["potential_gain"])}
                        </span>
                      </p>
                    </div>
                    <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-600">
                      sin puja
                    </span>
                  </div>
                  <.bid_slider :if={slider?(rec)} id={"bid-slider-#{rec["player_id"]}"} rec={rec} />
                </li>
              </ul>
            </div>

            <script :type={Phoenix.LiveView.ColocatedHook} name=".BidSlider">
              export default {
                mounted() {
                  this.input = this.el.querySelector("input[type=range]")
                  this.expected = Number(this.el.dataset.expected)
                  this.out = {
                    bid: this.el.querySelector('[data-out="bid"]'),
                    gain: this.el.querySelector('[data-out="gain"]'),
                    pct: this.el.querySelector('[data-out="pct"]'),
                  }
                  this.fmt = new Intl.NumberFormat("es-ES", { maximumFractionDigits: 0 })
                  this.input.addEventListener("input", () => this.render())
                  this.render()
                },
                render() {
                  const bid = Number(this.input.value) || 0
                  const gain = this.expected - bid
                  const pct = bid > 0 ? (gain / bid) * 100 : 0
                  this.out.bid.textContent = `${this.fmt.format(bid)} €`
                  this.out.gain.textContent = `${gain >= 0 ? "+" : "−"}${this.fmt.format(Math.abs(gain))} €`
                  this.out.pct.textContent = `${pct >= 0 ? "+" : ""}${pct.toFixed(1)}%`
                  this.out.gain.classList.toggle("text-emerald-600", gain >= 0)
                  this.out.gain.classList.toggle("text-red-600", gain < 0)
                },
              }
            </script>
          </section>
        </div>

        <div class="space-y-8 lg:col-span-2 lg:border-l lg:border-slate-200 lg:pl-10">
          <%!-- Alineación óptima --%>
          <section
            id="best-lineup"
            class="border-t border-slate-200 pt-5"
          >
            <div class="flex items-center justify-between gap-2">
              <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-700">
                <.icon name="hero-flag" class="h-5 w-5 text-emerald-600" /> Alineación óptima
              </h2>
              <.action_controls action={@action_map[{"lineup_change", nil}]} />
            </div>
            <div class="mt-3">
              <FormationPitch.pitch id="formation-pitch" lineup={@report.best_lineup} />
            </div>
            <div
              :if={(get_in(@report.best_lineup, ["excluded"]) || []) != []}
              id="excluded-players"
              class="mt-3 space-y-1.5"
            >
              <p class="text-xs font-bold uppercase tracking-wide text-slate-500">
                Fuera por lesión/sanción:
              </p>
              <p
                :for={excluded <- get_in(@report.best_lineup, ["excluded"])}
                id={"excluded-#{excluded["player_id"]}"}
                class="flex items-center gap-2 rounded-lg bg-red-50 px-2.5 py-1.5 text-xs text-red-800 ring-1 ring-red-200"
              >
                <.icon name="hero-heart" class="h-3.5 w-3.5 shrink-0" />
                <span class="font-bold">{excluded["name"]}</span>
                <span class="truncate opacity-80">— {excluded["reason"]}</span>
              </p>
            </div>
          </section>

          <%!-- Pistas de a quién poner en venta --%>
          <% slots = (@report.budget_summary || %{})["sale_slots"] || %{} %>
          <section
            id="sell-hints"
            class="border-t border-slate-200 pt-5"
          >
            <div class="flex items-center justify-between gap-2">
              <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-700">
                <.icon name="hero-tag" class="h-5 w-5 text-rose-500" /> Poner en venta
              </h2>
              <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-wide text-slate-600">
                {slots["listed"] || 0}/{slots["max"] || 5} en venta
              </span>
            </div>
            <p class="mt-1 text-xs text-slate-500">
              Fuera de tu mejor once y sin aportar puntos ni revalorización.
            </p>
            <ul class="mt-3 divide-y divide-slate-200">
              <li
                :for={hint <- List.wrap(@report.sell_hints)}
                id={"sell-hint-#{hint["player_id"]}"}
                class={[
                  "flex items-center justify-between gap-3 py-2.5 first:pt-0 last:pb-0",
                  done_or_dismissed?(@action_map[{"list", hint["player_id"]}]) && "opacity-60"
                ]}
              >
                <.player_side rec={hint} />
                <img
                  src={player_photo_url(hint["player_id"])}
                  alt={hint["name"]}
                  class="h-9 w-9 shrink-0 rounded-full bg-slate-100 object-cover ring-1 ring-slate-200"
                />
                <div class="min-w-0 flex-1">
                  <p class="flex flex-wrap items-center gap-1.5 font-bold text-slate-900">
                    {hint["name"]}
                    <span class={growth_classes(hint["growth_7d"])}>
                      {signed_pct(hint["growth_7d"]) || "sin datos"} 7d
                    </span>
                  </p>
                  <p class="text-xs text-slate-500">
                    media {pts(hint["season_avg"])} · valor {money(hint["market_value"])}
                  </p>
                  <p class="text-[11px] font-semibold text-rose-600">{hint["reason"]}</p>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <span
                    :if={get_in(hint, ["sale_range", "expected"])}
                    class="rounded-lg bg-violet-50 px-2.5 py-1 text-xs font-bold text-violet-700 ring-1 ring-violet-200"
                    title="Oferta esperada de la banca al ponerlo en venta"
                  >
                    ~ {money(get_in(hint, ["sale_range", "expected"]))}
                  </span>
                  <.action_controls action={@action_map[{"list", hint["player_id"]}]} />
                </div>
              </li>
            </ul>
            <p
              :if={@report.sell_hints in [nil, []]}
              class="mt-3 text-sm text-slate-500"
              id="sell-hints-none"
            >
              {if (slots["free"] || 0) == 0,
                do:
                  "Tienes el máximo de #{slots["max"] || 5} jugadores en venta. Retira alguno para liberar hueco.",
                else: "Nadie claro para vender: el resto de tu plantilla aporta o se revaloriza."}
            </p>
          </section>

          <%!-- En venta & ofertas recibidas (unificado) --%>
          <section
            id="sell-recommendations"
            class="border-t border-slate-200 pt-5"
          >
            <div class="flex items-center justify-between gap-2">
              <h2 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-slate-700">
                <.icon name="hero-banknotes" class="h-5 w-5 text-violet-600" /> En venta & ofertas
              </h2>
              <button
                type="button"
                phx-click="refresh_offers"
                id="refresh-offers"
                title="Recargar ofertas"
                class="flex h-9 w-9 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-600 active:scale-90 phx-click-loading:pointer-events-none phx-click-loading:opacity-60"
              >
                <.icon name="hero-arrow-path" class="h-4 w-4" />
              </button>
            </div>

            <%= if @offers_error do %>
              <p
                class="mt-3 rounded-xl bg-red-50 px-3 py-2 text-sm text-red-700 ring-1 ring-red-200"
                id="offers-error"
              >
                No se pudieron cargar las ofertas ({inspect(@offers_error)}).
              </p>
            <% end %>

            <ul class="mt-3 divide-y divide-slate-200">
              <li
                :for={entry <- sales_with_offers(@report, @offers)}
                id={"sale-#{entry.rec["player_id"]}"}
                class={[
                  "py-3 first:pt-0 last:pb-0",
                  done_or_dismissed?(sale_action(@action_map, entry.rec)) && "opacity-60"
                ]}
              >
                <% rec = entry.rec %>
                <% offer = entry.offer %>
                <% advice = sale_advice(rec, offer) %>
                <div class="flex items-center gap-3">
                  <.player_side rec={rec} />
                  <img
                    src={player_photo_url(rec["player_id"])}
                    alt={rec["name"]}
                    class="h-10 w-10 shrink-0 rounded-full bg-slate-100 object-cover ring-1 ring-slate-200"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="flex flex-wrap items-center gap-1.5 font-bold text-slate-900">
                      {rec["name"]}
                      <span
                        class={trend_classes(rec["trend"])}
                        title={"tendencia " <> (rec["trend"] || "flat")}
                      >
                        <.icon name={trend_icon(rec["trend"])} class="h-3.5 w-3.5" />
                        {trend_label(rec["trend"])}
                      </span>
                      <span
                        :if={rec["in_best_lineup"]}
                        class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-black uppercase tracking-wide text-indigo-700 ring-1 ring-indigo-300"
                      >
                        titular
                      </span>
                    </p>
                    <p class="text-xs text-slate-500">
                      valor de mercado {money(rec["market_price"])}
                      <span class={growth_classes(rec["growth_7d"])}>
                        · {signed_pct(rec["growth_7d"]) || "sin datos"} 7d
                      </span>
                    </p>
                  </div>
                  <%= if offer do %>
                    <span class={offer_advice_classes(advice)} title={elem(advice, 1)}>
                      {offer_advice_label(advice)}
                    </span>
                  <% else %>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600 ring-1 ring-slate-200">
                      sin ofertas
                    </span>
                  <% end %>
                  <.action_controls action={sale_action(@action_map, rec)} />
                </div>

                <p
                  :if={rec["in_best_lineup"]}
                  class="mt-2 flex items-center gap-1.5 rounded-lg bg-indigo-50 px-2.5 py-1.5 text-xs font-semibold text-indigo-800 ring-1 ring-indigo-200"
                >
                  <.icon name="hero-shield-check" class="h-4 w-4 shrink-0" />
                  No vender: es titular en tu mejor once. Retíralo de la venta.
                </p>

                <% range = rec["sale_range"] || %{} %>
                <p
                  :if={!rec["in_best_lineup"]}
                  class="mt-1.5 text-xs text-slate-500"
                >
                  oferta esperada
                  <span class="font-bold text-slate-700">{money(range["expected"])}</span>
                  <span class="opacity-70">(95–105%)</span>
                </p>

                <%= if offer do %>
                  <div class="mt-2 rounded-lg bg-orange-50 px-3 py-2">
                    <p class="text-xs font-semibold text-orange-900">
                      {offer.date} · puja de {if(offer.bidder_kind == :bank,
                        do: "la banca",
                        else: offer.bidder
                      )}: <span class="font-black">{money(offer.bid)}</span>
                      <span class="font-normal text-orange-700">
                        ({offer_advice_pct(offer)} del valor{if(offer.trend_dir == :up,
                          do: ", en alza",
                          else: ""
                        )})
                      </span>
                    </p>
                    <p
                      :if={purchase_line(offer, nil)}
                      class="mt-0.5 text-[11px] font-medium text-orange-800"
                    >
                      {purchase_line(offer, nil)}
                    </p>
                    <p class="mt-0.5 text-[11px] text-orange-700">
                      {elem(advice, 1)}
                    </p>
                    <div class="mt-2 flex flex-wrap gap-2">
                      <%= if @confirming == offer.id_bid do %>
                        <button
                          type="button"
                          phx-click="accept_offer"
                          phx-value-id_bid={offer.id_bid}
                          phx-value-amount={offer.bid}
                          id={"confirm-offer-#{offer.id_bid}"}
                          class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white shadow-md shadow-emerald-600/30 transition hover:bg-emerald-500 active:scale-95 phx-click-loading:pointer-events-none phx-click-loading:opacity-60"
                        >
                          Confirmar venta por {money(offer.bid)}
                        </button>
                        <button
                          type="button"
                          phx-click="cancel_accept"
                          id={"cancel-accept-#{offer.id_bid}"}
                          class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-slate-700 ring-1 ring-slate-300 transition hover:bg-slate-50 active:scale-95"
                        >
                          Cancelar
                        </button>
                      <% else %>
                        <button
                          type="button"
                          phx-click="accept_offer"
                          phx-value-id_bid={offer.id_bid}
                          phx-value-amount={offer.bid}
                          id={"accept-offer-#{offer.id_bid}"}
                          disabled={rec["in_best_lineup"] || elem(advice, 0) != :accept}
                          class={[
                            "rounded-lg px-3 py-1.5 text-xs font-bold transition active:scale-95 phx-click-loading:pointer-events-none phx-click-loading:opacity-60",
                            if(!rec["in_best_lineup"] && elem(advice, 0) == :accept,
                              do:
                                "bg-emerald-600 text-white shadow-md shadow-emerald-600/30 hover:bg-emerald-500",
                              else: "cursor-not-allowed bg-slate-200 text-slate-500"
                            )
                          ]}
                          title={
                            if(rec["in_best_lineup"],
                              do: "Es titular en tu mejor once: retíralo de la venta",
                              else:
                                if(elem(advice, 0) == :accept,
                                  do: "Aceptar la oferta en Mister",
                                  else:
                                    "El consejo actual es no aceptar; habilita solo si cambias de idea"
                                )
                            )
                          }
                        >
                          Aceptar oferta
                        </button>
                        <button
                          type="button"
                          phx-click="keep_on_sale"
                          phx-value-id_market={offer.id_market}
                          id={"resale-#{offer.id_market}"}
                          class="rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-slate-700 ring-1 ring-slate-300 transition hover:bg-slate-50 active:scale-95 phx-click-loading:pointer-events-none phx-click-loading:opacity-60"
                          title="Denegar la puja actual y seguir escuchando ofertas"
                        >
                          Mantener en venta
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </li>
            </ul>

            <p
              :if={sales_with_offers(@report, @offers) == []}
              class="mt-3 text-sm text-slate-500"
              id="sells-none"
            >
              Nadie en venta ahora mismo.
            </p>
          </section>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
